# Family Travel and Tours - Environment Variables
# Copy this file to .env and fill in your values.

# API base URL for the Next.js frontend (defaults to http://localhost:4000/api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API server port (server.js)
PORT=4000

# --- SMTP for sending enquiry/contact emails (optional) ---
# If not set, enquiries are logged to console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Recipients for submitted forms
ENQUIRY_RECIPIENT=
CONTACT_RECIPIENT=
